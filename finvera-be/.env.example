# Copy to .env and fill local-only values. Never commit .env.
# This is the ONLY env file finvera-be actually reads (IntelliJ run config
# "FinveraBeApplication" -> envFilePaths -> .env). Keep this example file
# and .env in sync; do not reintroduce a second/third env file.
FINVERA_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/finvera
FINVERA_DATABASE_USERNAME=postgres
FINVERA_DATABASE_PASSWORD=<your-local-postgres-password>

FINVERA_OWNER_ID=<owner-uuid>
FINVERA_OWNER_USERNAME=<owner-username>
FINVERA_OWNER_PASSWORD_HASH=<bcrypt-password-hash>

FINVERA_MARKET_PROVIDER_MODE=fixture
FINVERA_MARKET_PROVIDER_LIVE_ENABLED=false
FINVERA_MARKET_FIXTURE_BOOTSTRAP_ENABLED=true
FINVERA_MARKET_INDEX_CONTRACTED_DELAY=PT0S
FINVERA_STOCK_QUOTE_CONTRACTED_DELAY=PT15M

# Live TCBS iFlash (owner-only). Leave FINVERA_TCBS_API_KEY empty in fixture mode.
# Set FINVERA_MARKET_PROVIDER_MODE=live (exactly "live", not any other value)
# and FINVERA_MARKET_PROVIDER_LIVE_ENABLED=true to activate.
FINVERA_TCBS_BASE_URL=https://openapi.tcbs.com.vn
FINVERA_TCBS_API_KEY=<owner-tcbs-iflash-api-key>
FINVERA_MARKET_TCBS_POLL_INTERVAL_MS=60000

# Keep disabled for ordinary fixture-mode development.
FINVERA_MARKET_IMPORT_ENABLED=false
FINVERA_MARKET_IMPORT_PACKAGE_PATH=

# Registers the symbol universe into market_instrument (export_instrument_reference.py's output).
# Unlike the daily-bar/fundamentals/sector-reference imports below, this points at the single
# output FILE (instrument-reference.json), not a directory -- the exporter only ever produces one.
# MUST be run to completion (as its own restart, alone) BEFORE enabling the Feature 002
# daily-bar/fundamentals imports below -- those reject any symbol that isn't already an active
# market_instrument row. Disable this again once the count looks right; it is safe to leave
# enabled too (it only creates rows that don't already exist), but one dataset at a time keeps
# each restart's log easy to read.
FINVERA_MARKET_IMPORT_INSTRUMENT_REFERENCE_ENABLED=false
FINVERA_MARKET_IMPORT_INSTRUMENT_REFERENCE_PACKAGE_PATH=

# Feature 002 stock detail: live-gated sections.
# quote-live-enabled additionally requires FINVERA_MARKET_PROVIDER_MODE=live
# above (it reuses that same TCBS session). sector-basis-enabled: validate
# latency in a non-production run before enabling in production.
# (Fundamentals and corporate-actions have no equivalent flag: fundamentals
# go live purely by importing data - see below - and corporate-actions has
# no live adapter at all, by owner decision; see research.md R-012 G-01/G-02.)
FINVERA_STOCK_QUOTE_LIVE_ENABLED=false
FINVERA_STOCK_SECTOR_BASIS_ENABLED=false
FINVERA_STOCK_CHART_MAX_WINDOW=2Y

# Feature 002 owner-triggered Vnstock import boundaries (ADR-0004: never live/scheduled).
# Enable one at a time, point *_PACKAGE_PATH at a package from tools/market-data/vnstock-export/,
# start the app once to run the importer, then disable again.
FINVERA_STOCK_IMPORT_DAILY_BAR_ENABLED=false
FINVERA_STOCK_IMPORT_DAILY_BAR_PACKAGE_PATH=
FINVERA_STOCK_IMPORT_FUNDAMENTALS_ENABLED=false
FINVERA_STOCK_IMPORT_FUNDAMENTALS_PACKAGE_PATH=
FINVERA_STOCK_IMPORT_SECTOR_REFERENCE_ENABLED=false
FINVERA_STOCK_IMPORT_SECTOR_REFERENCE_PACKAGE_PATH=

# Internal Security & Routing between Spring Boot and the finvera-ai FastAPI service
# (Features 006/007). Must match finvera-ai/.env's INTERNAL_API_KEY exactly.
FINVERA_RESEARCH_INTERNAL_API_KEY=dev-internal-key-change-in-prod
FINVERA_RESEARCH_AI_SERVICE_URL=http://127.0.0.1:8000/internal/v1
FINVERA_ANALYST_INTERNAL_API_KEY=dev-internal-key-change-in-prod
FINVERA_ANALYST_AI_SERVICE_URL=http://127.0.0.1:8000
