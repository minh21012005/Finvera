# Owner-run data-refresh overrides, layered on top of .env by refresh-data.ps1 (repo root).
# Contains ONLY import/warmup toggles -- no secrets, no paths -- so it never goes stale relative
# to .env and is safe to commit. The script applies these as temporary process-environment
# overrides for a few short-lived backend restarts; it never edits .env itself, so IntelliJ's own
# run configuration (which reads .env directly) is completely unaffected.
#
# Do not run the backend normally with this file loaded -- these flags cause the app to reprocess
# the whole symbol universe on every startup, which is slow and just adds noisy logs once the data
# is already current (each import is safe/idempotent, but pointless to repeat every ordinary run).
# refresh-data.ps1 turns these on and off itself, one dependency-safe stage at a time
# (instrument-reference, then equity-profile, then market-overview index history, then
# daily-bar + fundamentals, then warmup) -- this file just documents the full set it
# manages. Sector reference is NOT included: industries change rarely enough that it stays
# a separate, occasional manual step (see go-live-setup.md 3.7/6.3);
# its output filename also embeds the installed vnstock package version, so it needs a one-time
# path check in .env whenever that version changes, unlike the others here.
FINVERA_MARKET_IMPORT_ENABLED=true
FINVERA_MARKET_IMPORT_INSTRUMENT_REFERENCE_ENABLED=true
FINVERA_STOCK_IMPORT_EQUITY_PROFILE_ENABLED=true
FINVERA_STOCK_IMPORT_DAILY_BAR_ENABLED=true
FINVERA_STOCK_IMPORT_FUNDAMENTALS_ENABLED=true
FINVERA_STOCK_TECHNICAL_WARMUP_ENABLED=true
FINVERA_STOCK_VALUATION_WARMUP_ENABLED=true
