# Copy to .env and fill local-only values. Never commit .env.
# Read directly by app/core/settings.py (pydantic-settings, env_file=".env").
# This is the only env file finvera-ai reads.

# Service info
ENVIRONMENT=development

# Security (X-Internal-Api-Key) - must match finvera-be's
# FINVERA_RESEARCH_INTERNAL_API_KEY / FINVERA_ANALYST_INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=dev-internal-key-change-in-prod

# Gemini LLM & Embedding (ADR-0002, ADR-0008). Register a free key at
# https://aistudio.google.com/ - required for Features 006/007 to actually
# call the LLM; without a real key, RAG/AI-analyst calls will fail.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
EMBEDDING_VERSION=gemini-embedding-v1

# Qdrant Vector DB (research R-006). Must be running locally before
# Features 006/007 can retrieve anything - it is not started by this app.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=research_chunks_v1

# Ingestion Callback (finvera-be URL this service calls back into)
BACKEND_INTERNAL_API_URL=http://127.0.0.1:8080/internal/v1

# Feature 007 - AI Analyst tool-call bounds
ANALYST_MAX_TOOL_CALLS=10
ANALYST_TOOL_CALL_TIMEOUT_SECONDS=10.0
ANALYST_ASK_TIMEOUT_SECONDS=30.0
